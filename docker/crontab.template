# Alerts
*/5  * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/check-alerts >> /var/log/cron.log 2>&1

# Candle sync - standard intervals (15m, 1h, 4h, 1d)
*/15 * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/sync-candles >> /var/log/cron.log 2>&1
# Candle sync - high-frequency intervals
*/1  * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/sync-candles?intervals=1m" >> /var/log/cron.log 2>&1
*/5  * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/sync-candles?intervals=5m" >> /var/log/cron.log 2>&1

# Global signal computation - per style at appropriate frequencies. Offset
# one minute after the matching sync-candles cron above, so compute always
# reads the bar that just closed in the same cycle instead of racing sync
# for it (a tie at the same minute means compute can read last cycle's bar
# and not pick up the new close until the next cycle, up to a full cycle
# late). Scalping's 1m/5m intervals sync every minute already, so no offset
# is needed there.
*/1  * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/compute-signals?style=scalping" >> /var/log/cron.log 2>&1
1-59/5 * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/compute-signals?style=day_trading" >> /var/log/cron.log 2>&1
1-59/15 * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/compute-signals?style=swing_trading" >> /var/log/cron.log 2>&1
1    * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/compute-signals?style=position_trading" >> /var/log/cron.log 2>&1

# Signal outcome resolution
# This file is bind-mounted read-only; `docker compose up -d --build` does not
# recreate the cron container on its own when only this file changes. After
# deploying, run: docker compose -f docker-compose.server.yml up -d --force-recreate cron
*/15 * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/resolve-outcomes >> /var/log/cron.log 2>&1

# Historical data snapshots
*/15 * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/ingest-snapshots?interval=1h" >> /var/log/cron.log 2>&1
0    */4 * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/ingest-snapshots?interval=4h" >> /var/log/cron.log 2>&1
0    0   * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/ingest-snapshots?interval=1d" >> /var/log/cron.log 2>&1

# Binance archive metrics and book depth. The archive publishes a day's file
# after that day ends, so this is a history keeper running a day behind, not a
# live feed; the three-day window overlaps on purpose, because every write is an
# idempotent upsert and a late-published day is picked up by the next run.
# Bulk history is scripts/ops/ingest-archive.ts from the seeder image, not this.
#
# 10:00 UTC, not 05:30, and the time is measured rather than guessed. On
# 2026-09-25 the previous day's metrics file was still a 404 at 01:34Z and a 200
# by 07:48Z, so publication lands somewhere inside that window and an 05:30 run
# sat in the middle of it: sometimes it caught the day, sometimes it did not,
# and the series habitually sat TWO days behind instead of one, catching up only
# on the following run. 10:00 clears the latest observed publication by over two
# hours. If the series starts lagging again, re-measure the 404-to-200 boundary
# before moving this, since the lag is Binance's to change.
0    10 * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/ingest-archive?days=3" >> /var/log/cron.log 2>&1

# Perpetual bar history from the same archive. The kline datasets are published
# daily as well as monthly, and this route asks for the DAILY cadence, because
# the monthly file for a month does not exist until that month ends. Its own
# line and its own route on purpose: FuturesMetric above is on the live signal
# path and this collection is research-only, so a failure here must not be able
# to touch that run. Half an hour later keeps the two archive-heavy jobs from
# overlapping inside the one app container and gives a clean log boundary.
30   10 * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/ingest-perp?days=3" >> /var/log/cron.log 2>&1

# Paper desk: step every paper book over its newly closed bars. Every minute
# because the 1m book needs it; a book with nothing new to step returns in a
# couple of queries, and each book takes a lease so an overlapping run is a
# no-op rather than a double-step.
*/1  * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/paper-desk >> /var/log/cron.log 2>&1

# Portfolio snapshots
0    0 * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/snapshot-portfolios >> /var/log/cron.log 2>&1

# 8-Hour Cross-Sectional Relative Value (rv-v1) signals and paper desk. The
# signal job scores the bar that closed a minute earlier and stores it once.
# The retry line thirty minutes later runs the same job: a stored signal is
# never rewritten, so it only fills a bar the first line could not store.
1    */8 * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/cross-sectional-signals >> /var/log/cron.log 2>&1
31   */8 * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/cross-sectional-signals?attempt=retry" >> /var/log/cron.log 2>&1
# The desk fills at the 8h close using the first 1h bar after it (maker or
# taker fallback), so it runs once that bar has closed: 01:05, 09:05, 17:05 UTC.
5    1-23/8 * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/cross-sectional-paper >> /var/log/cron.log 2>&1

# Forward signal lab (lab-v1, lock scripts/research/lab-forward-v1.ts).
# The 8h job scores L1, L3 and L4 at minutes 3 and 8 after each 8h close
# (the first attempt writes nothing for a hypothesis whose REST fetch failed,
# the final one writes what it has), the fast job scores L2 every minute
# within D of each close, the grade job runs hourly, and every stored lab row
# is write-once.
3    */8 * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/lab-signals?cadence=8h" >> /var/log/cron.log 2>&1
8    */8 * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/lab-signals?cadence=8h&attempt=retry" >> /var/log/cron.log 2>&1
*/1  * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/lab-signals?cadence=fast" >> /var/log/cron.log 2>&1
3    0   * * 1 wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/lab-signals?cadence=v2-1w" >> /var/log/cron.log 2>&1
8    0   * * 1 wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/lab-signals?cadence=v2-1w&attempt=retry" >> /var/log/cron.log 2>&1
3    0   * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/lab-signals?cadence=v2-1d" >> /var/log/cron.log 2>&1
8    0   * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" "http://app:3000/api/cron/lab-signals?cadence=v2-1d&attempt=retry" >> /var/log/cron.log 2>&1
20   * * * * wget -qO- --header="Authorization: Bearer ${CRON_SECRET}" http://app:3000/api/cron/lab-grade >> /var/log/cron.log 2>&1

# Log rotation. The log lives in the container's writable layer with no logrotate
# available, and had grown to 60MB in production. Truncating in place keeps the
# entrypoint's `tail -f` attached to the same file.
0    3 * * * [ -f /var/log/cron.log ] && [ "$(wc -c < /var/log/cron.log)" -gt 10485760 ] && : > /var/log/cron.log
