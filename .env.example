# Database
MONGODB_URI=mongodb://localhost:27017/cryptowithalgo

# Redis
REDIS_URL=redis://localhost:6379

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Binance API (configurable for proxy/geo-restrictions)
BINANCE_API_URL=https://api.binance.com/api/v3
NEXT_PUBLIC_BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_FUTURES_API_URL=https://fapi.binance.com

# Market recorder (scripts/ops/market-recorder.ts, the `recorder` service).
# The WebSocket base must keep the /market route: since 2026-04-23 the legacy
# path delivers no aggTrade or forceOrder data.
# BINANCE_FUTURES_WS_URL=wss://fstream.binance.com/market
# RECORDER_TOP_N=50


# Admin
ADMIN_EMAIL=

# Cron
CRON_SECRET=

# LLM panel (local Claude Code skill posting calls to /api/admin/llm-calls)
LLM_PANEL_SECRET=

# Registration gate -- set to "true" to allow new account sign-ups
# (disabled by default; required to create your first account)
ALLOW_REGISTRATION=

# Seed script (npm run seed)
# SEED_EMAIL and SEED_PASSWORD are required to create the demo account;
# SEED_NAME is the optional display name (defaults to "Demo User").
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=

# Email (MailerSend SMTP)
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CryptoWithAlgo <noreply@cryptowithalgo.com>

# Cloudflare Turnstile (anti-spam on email-sending endpoints)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Binance USDⓈ-M futures DEMO trading (paper desk mirror; PR 3)
# Keys come from the demo account, which since the 2026 revamp lives behind the
# main Binance login at demo.binance.com (testnet.binancefuture.com now
# redirects there). REST base is https://demo-fapi.binance.com, and the
# execution client refuses every other host.
# NEVER commit values. On the VPS these live in /opt/sites/crypto/.env.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
# The one book mirrored to the demo account, as <style>:<interval>.
DEMO_BOOK=day_trading:1h
# Dry run until this is explicitly true: the mirror logs intended orders only.
DEMO_EXECUTION_ENABLED=false
